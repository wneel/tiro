        }
      }
    },
    "Notifications allowed": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications autorisées"
          }
        }
      }
    },
    "Notifications are off. Tiro still records, but it cannot tell you.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notifications sont désactivées. Tiro enregistre quand même, mais ne peut pas vous prévenir."
          }
        }
      }
    },
    "Open": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrir"
          }
        }
      }
    },
