{
  "sourceLanguage": "en",
  "strings": {
    "%@ was saved after Tiro stopped unexpectedly.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a été sauvegardé après un arrêt inattendu de Tiro."
          }
        }
      }
    },
    "A call starts when one of these apps uses the microphone. Browsers count, so calls in Google Meet or Teams on the web are caught too.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un appel commence quand l’une de ces apps utilise le micro. Les navigateurs comptent aussi : les appels Google Meet ou Teams sur le web sont donc détectés."
          }
        }
      }
    },
    "A free tool by Animalert, a French non-profit.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un outil gratuit d’Animalert, une association française."
          }
        }
      }
    },
    "A whisper.cpp model in ggml format (.bin). When set, it replaces the model above.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un modèle whisper.cpp au format ggml (.bin). S’il est choisi, il remplace le modèle ci-dessus."
          }
        }
      }
    },
    "About": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À propos"
          }
        }
      }
    },
    "About Tiro": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À propos de Tiro"
          }
