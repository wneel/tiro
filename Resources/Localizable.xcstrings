      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autoriser l’audio du système"
          }
        }
      }
    },
    "Allow Tiro in System Settings, under Login Items.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez Tiro dans Réglages Système, rubrique Ouverture."
          }
        }
      }
    },
    "Apps": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps"
          }
        }
      }
    },
    "Ask Claude about your calls": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demandez à Claude vos notes d’appel"
          }
        }
      }
    },
    "Automatic": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatique"
          }
        }
      }
    },
    "Automatic detects the language of each call. Pick one if your calls are always in the same language.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En automatique, la langue de chaque appel est détectée. Choisissez-en une si vos appels sont toujours dans la même langue."
          }
        }
      }
    },
    "Back": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retour"
          }
        }
      }
    },
    "Balanced (small)": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Équilibré (small)"
          }
        }
      }
    },
    "Before your first call": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avant votre premier appel"
          }
        }
      }
    },
    "Best (large-v3 turbo)": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le plus précis (large-v3 turbo)"
          }
        }
      }
    },
    "Call ended · saving…": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appel terminé · sauvegarde…"
          }
