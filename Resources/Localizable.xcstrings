      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajouter une app…"
          }
        }
      }
    },
    "Allow Microphone": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autoriser le micro"
          }
        }
      }
    },
