      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer %@ ?"
          }
        }
      }
    },
    "Delete…": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer…"
          }
        }
