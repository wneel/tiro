          }
        }
      }
    },
    "Open Tiro at login": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrir Tiro à l’ouverture de session"
          }
        }
      }
    },
    "Open at login": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À l’ouverture de session"
          }
        }
      }
    },
    "Others": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les autres"
          }
        }
      }
    },
    "Paste this once into Claude, or any assistant that can read files on this Mac, and ask it to remember it. Then just ask for your last meeting notes.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Collez-le une fois dans Claude, ou dans tout assistant qui peut lire les fichiers de ce Mac, en lui demandant de le retenir. Ensuite, demandez simplement les notes de votre dernière réunion."
          }
        }
      }
    },
    "Paste this prompt once into Claude, or any assistant that can read files on this Mac. Then ask it for your last meeting notes.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Collez ce prompt une fois dans Claude, ou dans tout assistant qui peut lire les fichiers de ce Mac. Demandez-lui ensuite les notes de votre dernière réunion."
          }
        }
      }
    },
