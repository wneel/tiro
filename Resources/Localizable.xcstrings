          }
        }
      }
    },
    "Choose": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisir"
          }
        }
      }
    },
    "Choose a whisper.cpp model file (.bin).": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un fichier de modèle whisper.cpp (.bin)."
          }
        }
      }
    },
    "Choose the apps you make calls with.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez les apps avec lesquelles vous passez vos appels."
          }
        }
      }
    },
    "Choose where Tiro saves your recordings.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez où Tiro range vos enregistrements."
